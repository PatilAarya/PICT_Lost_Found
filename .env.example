# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pict-lost-found
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Cloudinary (photo storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (one-time login codes). Fill these in to send real emails to the user's inbox.
# Leave SMTP_HOST empty and the code is printed in the server console instead.
# Free option 1, Brevo (300 emails a day, no domain needed):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SMTP_USER and SMTP_PASS = the SMTP login and key from Brevo > SMTP and API
#   SMTP_FROM must use the sender email you verified in Brevo.
# Free option 2, Gmail (about 500 a day; needs 2-step verification on that Google account):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#   SMTP_USER = the Gmail address, SMTP_PASS = a 16-character App password (not your password)
#   SMTP_FROM must use that same Gmail address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PICT Lost and Found <your-verified-sender@example.com>"

# Login rules. Only emails ending in these domains may log in (comma separated),
# unless ALLOW_ANY_EMAIL=true. For the teacher demo set ALLOW_ANY_EMAIL=false and DEV_AUTH=false.
ALLOWED_EMAIL_DOMAINS=ms.pict.edu,pict.edu
DEV_AUTH=true
ALLOW_ANY_EMAIL=true

# Item and claim rules
HOLD_HOURS_DESK=24
DONATE_AFTER_DAYS=30
HANDOVER_CODE_HOURS=24
MAX_CLAIM_ATTEMPTS=3
LOCKOUT_MINUTES=30
