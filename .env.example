# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pict-lost-found
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Cloudinary (photo storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (one-time login codes). Leave SMTP_HOST empty in dev: codes are printed in the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PICT Lost and Found <no-reply@pict.edu>"

# Login rules
ALLOWED_EMAIL_DOMAINS=pict.edu
DEV_AUTH=true
ALLOW_ANY_EMAIL=true

# Item and claim rules
HOLD_HOURS_DESK=24
DONATE_AFTER_DAYS=30
HANDOVER_CODE_HOURS=24
MAX_CLAIM_ATTEMPTS=3
LOCKOUT_MINUTES=30
